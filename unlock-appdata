#!/bin/bash

set -euo pipefail
source /usr/local/lib/odoo-appdata.sh

[[ $EUID == 0 ]] || fail 'Run as root.'
case ${1:-} in
    --check) check_appdata; exit 0 ;;
    --mount-only|'') ;;
    *) fail 'Usage: unlock-appdata [--check|--mount-only]' ;;
esac

# Serialize interactive unlocks, but never hold this lock in service checks.
exec 9>/run/lock/odoo-appdata.lock
flock 9
cryptsetup status appdata >/dev/null || cryptsetup open "$(appdata_device)" appdata
mount_appdata
[[ ${1:-} != --mount-only ]] || exit 0

flock /run/lock/odoo-nginx.lock nginx -t
systemctl start odoo-app.target
# A target may already be active after an earlier partial failure. Retry its
# services too, including every installed release and PostgreSQL cluster.
read -ra services <<< "$(systemctl show odoo-app.target -p Requires -p Wants --value | tr '\n' ' ')"
for service in "${services[@]}"; do
    [[ "$service" == *.service ]] || continue
    systemctl start "$service"
    systemctl is-active --quiet "$service" || fail "$service did not start."
done
