[Unit]
Description=rclone-mount
Wants=network-online.target
After=network-online.target
PartOf=odoo-app.target

[Service]
Type=notify
User=root
ExecStart=/usr/bin/rclone mount backup-crypt: /root/backups --vfs-cache-mode full --cache-dir /root/.cache/rclone
ExecStop=/usr/bin/fusermount3 -u /root/backups
Restart=on-abort

[Install]
WantedBy=odoo-app.target
