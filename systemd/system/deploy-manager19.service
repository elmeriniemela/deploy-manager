[Unit]
Description=deploy-manager Odoo 19
Requires=docker.service postgresql@18-main.service rclone-mount.service
After=docker.service postgresql@18-main.service rclone-mount.service
PartOf=odoo-app.target
StartLimitIntervalSec=120
StartLimitBurst=30

[Service]
User=root
WorkingDirectory=/opt/19
ExecStart=/usr/bin/python3 -m agentd --interface 127.0.0.1 --port 8019
Restart=always
RestartSec=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TMPDIR=/srv/secure/tmp
StandardOutput=append:/srv/secure/logs/deploy-manager19.log
StandardError=inherit

[Install]
WantedBy=odoo-app.target
